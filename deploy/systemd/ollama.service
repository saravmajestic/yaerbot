[Unit]
Description=Ollama server (yaerbot on-device LLM)
After=network-online.target
Wants=network-online.target

[Service]
User=arduino
Group=arduino
Environment=HOME=/home/arduino
Environment=OLLAMA_MODELS=/home/arduino/.ollama/models
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=LD_LIBRARY_PATH=/home/arduino/ollama-dist/lib/ollama
ExecStart=/home/arduino/ollama-dist/bin/ollama serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
